<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UI Debug Launcher"
        android:textColor="@color/text_brown"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Pilih Activity untuk membukanya tanpa splash dan login. Token serta permission API tetap menggunakan sesi asli."
        android:textColor="@color/primary_dark"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/debugLastScreenText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/text_brown"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/debugAutoOpenSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Buka layar terakhir otomatis saat Run"
        android:textColor="@color/text_brown"
        app:buttonTint="@color/accent_green" />

    <EditText
        android:id="@+id/debugSearchInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/border_input"
        android:hint="Cari Activity..."
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/text_brown"
        android:textColorHint="@color/primary_dark" />

    <ListView
        android:id="@+id/debugActivityList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:divider="@color/gray"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debugOpenLastButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Buka Terakhir"
            android:textColor="@color/white"
            app:backgroundTint="@color/accent_green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debugNormalLoginButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Login Normal"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary" />
    </LinearLayout>

</LinearLayout>
