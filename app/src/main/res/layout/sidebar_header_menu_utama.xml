<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sidebarHeader"
    android:layout_width="match_parent"
    android:layout_height="116dp"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/sidebarLogo"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/logo_wps"
        app:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/sidebarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/sidebar_brand_title"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/sidebarLogo"
        app:layout_constraintTop_toTopOf="@id/sidebarLogo" />

    <TextView
        android:id="@+id/sidebarSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/sidebar_brand_subtitle"
        android:textColor="@color/sidebar_brand_detail"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/sidebarTitle"
        app:layout_constraintTop_toBottomOf="@id/sidebarTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
